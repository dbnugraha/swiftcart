# The build context is the repo root, so this file decides how much of the
# monorepo the daemon has to read. Keeping it small is most of the build time.

# dependencies — reinstalled from the lockfile inside the image
node_modules
**/node_modules

# builds — recompiled inside the image, and a host build would be the wrong
# platform for any native dependency
dist
build
**/dist
**/build
*.tsbuildinfo

# secrets — configuration reaches the container through the environment.
# Baking a .env into an image leaks it to anyone who can pull the image.
.env
.env.*
!.env.example

# the mobile client — the server never loads it, and Expo's tree is enormous.
# Its manifest still has to be present or npm cannot reconcile the lockfile
# against the workspace list.
apps/mobile/**
!apps/mobile/package.json

# the generated Prisma client — regenerated by `prisma generate` during build
apps/api/src/generated

# vcs, tooling, docs
.git
.gitignore
.github
.expo
.vscode
.idea
Dockerfile
**/Dockerfile
.dockerignore
docker-compose*.yml
README.md
**/*.md
*.log
npm-debug.log*
.DS_Store
Thumbs.db
