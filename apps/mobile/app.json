{
  "expo": {
    "name": "Swiftcart",
    "slug": "swiftcart",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "swiftcart",
    "userInterfaceStyle": "light",
    "android": {
      "package": "test.swiftcart.app",
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "test.swiftcart.app",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "76aa3168-a6ed-41d4-b929-c795c2dfdfef"
      }
    }
  }
}
