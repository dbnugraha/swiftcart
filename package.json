{
  "name": "swiftcart",
  "version": "1.0.0",
  "private": true,
  "description": "Swiftcart — a demo e-commerce app: Expo mobile client, Express + Prisma API, Postgres.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "api": "npm run dev --workspace @swiftcart/api",
    "mobile": "npm run start --workspace @swiftcart/mobile",
    "mobile:tunnel": "npm run start:tunnel --workspace @swiftcart/mobile",
    "mobile:adb": "npm run start:adb --workspace @swiftcart/mobile",
    "migrate": "npm run migrate:dev --workspace @swiftcart/api",
    "seed": "npm run seed --workspace @swiftcart/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "cross-env": "^10.1.0"
  }
}
